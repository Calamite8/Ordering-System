<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Stock Board tab. Open in Scene Builder to adjust layout/spacing.
  fx:id values must match @FXML fields in StockBoardController.java.
-->

<BorderPane styleClass="root-bg" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.larrystapsihan.inventory.StockBoardController">
    <padding>
        <Insets bottom="18" left="18" right="18" top="18" />
    </padding>

    <top>
        <VBox spacing="4">
            <children>
                <Label styleClass="section-title" text="Stock Board" />
                <Label styleClass="section-note" text="Live ingredient levels · updates as tickets are punched and stock comes in" />
            </children>
            <BorderPane.margin>
                <Insets bottom="14" />
            </BorderPane.margin>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <FlowPane fx:id="grid" hgap="14" prefWrapLength="900" vgap="14" />
            </content>
        </ScrollPane>
    </center>
</BorderPane>
